# Node + SQLite. The database file must be on a persistent local disk.
DATABASE_PATH=./data/bullao.sqlite
PORT=8080
BETTER_AUTH_URL=http://localhost:8080
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional extraction service. Demo fixtures and XML need no model or API key.
LOVABLE_API_KEY=

# Local demo personas have the same permissions, not separate roles.
# `pnpm run setup` generates random passwords only in .env.local.
DEMO_OPERATIONS_EMAIL=operaciones@demo.bullao.test
DEMO_OPERATIONS_PASSWORD=
DEMO_FINANCE_EMAIL=responsable@demo.bullao.test
DEMO_FINANCE_PASSWORD=
DEMO_CONSULTANT_EMAIL=consulta@demo.bullao.test
DEMO_CONSULTANT_PASSWORD=
